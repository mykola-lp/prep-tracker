@baseUrl = http://localhost:3001/api/graphql
@token = YOUR_TOKEN_FROM_CREATE_USER (user1 & user2)
@topicId = 1
@questionId = 1
@noteId = 1

### Register a new user1
POST {{baseUrl}}
Content-Type: application/json

{
  "query": "mutation { register(input: { email: \"a@test.com\", password: \"password123\", displayName: \"User A\" }) { token user { id email } } }"
}

### Create a topic (needed before creating a note attached to a topic)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { createTopic(input: { title: \"JS\", description: \"JavaScript basics\" }) { id title description status } }"
}

### Create a question (needed before creating a note attached to a question)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { createQuestion(input: { topicId: {{topicId}}, prompt: \"What is a closure?\" }) { id prompt } }"
}

### Create a note attached to a topic
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { createNote(input: { topicId: {{topicId}}, body: \"Remember: closures capture scope\" }) { id body topicId questionId } }"
}

### Create a note attached to a question
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { createNote(input: { questionId: {{questionId}}, body: \"A closure captures the enclosing scope\" }) { id body topicId questionId } }"
}

### Create a note with both topicId and questionId (should fail — VALIDATION_ERROR)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { createNote(input: { topicId: {{topicId}}, questionId: {{questionId}}, body: \"Invalid note\" }) { id } }"
}

### Create a note with neither topicId nor questionId (should fail — VALIDATION_ERROR)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { createNote(input: { body: \"Orphan note\" }) { id } }"
}

### List notes
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query { notes { id body } }"
}

### Get a single note by id
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query { note(id: {{noteId}}) { id body } }"
}

### Update a note
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { updateNote(id: {{noteId}}, input: { body: \"Updated note body\" }) { id body } }"
}

### Delete a note
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { deleteNote(id: {{noteId}}) }"
}

### Request without a token (should fail — UNAUTHENTICATED)
POST {{baseUrl}}
Content-Type: application/json

{
  "query": "query { notes { id body } }"
}

### Request with an invalid token
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer invalid.token.here

{
  "query": "query { notes { id body } }"
}

### Register a new user2
POST {{baseUrl}}
Content-Type: application/json

{
  "query": "mutation { register(input: { email: \"b@test.com\", password: \"password123\", displayName: \"User B\" }) { token user { id email } } }"
}

### Attach a note to another user's topic (should fail — NOT_FOUND)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { createNote(input: { topicId: {{topicId}}, body: \"Trying to attach to a foreign topic\" }) { id } }"
}

### Attach a note to another user's question (should fail — NOT_FOUND)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { createNote(input: { questionId: {{questionId}}, body: \"Trying to attach to a foreign question\" }) { id } }"
}

### Access another user's note (should fail — NOT_FOUND)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "query { note(id: 999) { id body } }"
}

### Update another user's note (should fail — NOT_FOUND)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { updateNote(id: 999, input: { body: \"Hacked\" }) { id body } }"
}

### Delete another user's note (should fail — NOT_FOUND)
POST {{baseUrl}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "query": "mutation { deleteNote(id: 999) }"
}
